{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-05",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "cv_visits" }
  ],
  "observability": {
    "enabled": true
  }
}
